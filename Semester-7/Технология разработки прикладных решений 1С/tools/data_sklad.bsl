&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Сообщения = Новый Массив;

	// --- цвета ---
	ЦветаСписок = "Зеленый,Красный,Стальной,Белый,Черный";
	Для Каждого ИмяЦвета Из СтрРазделить(ЦветаСписок, ",") Цикл
		Если Справочники.ЦветаТоваров.НайтиПоКоду(ИмяЦвета).Пустая() Тогда
			Э = Справочники.ЦветаТоваров.СоздатьЭлемент();
			Э.Код = ИмяЦвета;
			Э.Наименование = ИмяЦвета;
			Э.Записать();
		КонецЕсли;
	КонецЦикла;

	// --- страны ---
	СтраныСписок = "Россия,Китай,Германия";
	Для Каждого ИмяСтраны Из СтрРазделить(СтраныСписок, ",") Цикл
		Если Справочники.СтраныТоваров.НайтиПоКоду(ИмяСтраны).Пустая() Тогда
			Э = Справочники.СтраныТоваров.СоздатьЭлемент();
			Э.Код = ИмяСтраны;
			Э.Наименование = ИмяСтраны;
			Э.Записать();
		КонецЕсли;
	КонецЦикла;

	// --- склады ---
	СкладОсновной = СоздатьСклад("Склад основной", "Москва, ул. Строительная, д. 1", НачалоДня(ТекущаяДатаСеанса()));
	СкладДопол    = СоздатьСклад("Склад дополнительный", "Тверь, ул. Садовая, д. 2", '00010101');

	// --- группы и товары ---
	ГруппаТехника = СоздатьГруппуТоваров("Бытовая техника");
	ГруппаСад     = СоздатьГруппуТоваров("Для сада и огорода");
	ГруппаЭлектро = СоздатьГруппуТоваров("Электроника");

	Чайник  = СоздатьТовар("Чайник (3 л)", ГруппаТехника, "Стальной", "Россия");
	Грабли  = СоздатьТовар("Грабли садовые", ГруппаСад, "Зеленый", "Россия");
	Краска  = СоздатьТовар("Краска половая (5 л)", ГруппаСад, "Красный", "Китай");
	Наушник = СоздатьТовар("Наушники", ГруппаЭлектро, "Черный", "Китай");
	Часы    = СоздатьТовар("Умные часы", ГруппаЭлектро, "Белый", "Германия");

	// --- документы прихода ---
	СоздатьПриход(СкладОсновной, '20260901120000', Новый Структура("Позиции",
		Позиции(Чайник, 50, Грабли, 20, Наушник, 15)));
	СоздатьПриход(СкладДопол, '20260902130000', Новый Структура("Позиции",
		Позиции(Краска, 30, Часы, 10, Неопределено, 0)));

	// --- документ расхода ---
	СоздатьРасход(СкладОсновной, '20260903140000', Чайник, 12);

	Итог = "Тестовые данные загружены: справочники, 5 товаров, 2 прихода, 1 расход.";

КонецПроцедуры

&НаСервереБезКонтекста
Функция Позиции(Т1, К1, Т2, К2, Т3, К3)
	М = Новый Массив;
	Если ЗначениеЗаполнено(Т1) Тогда М.Добавить(Новый Структура("Товар,Количество", Т1, К1)); КонецЕсли;
	Если ЗначениеЗаполнено(Т2) Тогда М.Добавить(Новый Структура("Товар,Количество", Т2, К2)); КонецЕсли;
	Если ЗначениеЗаполнено(Т3) Тогда М.Добавить(Новый Структура("Товар,Количество", Т3, К3)); КонецЕсли;
	Возврат М;
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьСклад(Наименование, Адрес, ДатаИнвентаризации)
	Ссылка = Справочники.Склады.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Э = Справочники.Склады.СоздатьЭлемент();
		Э.Наименование = Наименование;
		Э.АдресСклада = Адрес;
		Если Метаданные.Справочники.Склады.Реквизиты.Найти("Инвентаризация") <> Неопределено Тогда
			Э.Инвентаризация = ДатаИнвентаризации;
		КонецЕсли;
		Э.Записать();
		Возврат Э.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьГруппуТоваров(Наименование)
	Ссылка = Справочники.Товары.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Г = Справочники.Товары.СоздатьГруппу();
		Г.Наименование = Наименование;
		Г.Записать();
		Возврат Г.Ссылка;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьТовар(Наименование, Группа, ИмяЦвета, ИмяСтраны)
	Ссылка = Справочники.Товары.НайтиПоНаименованию(Наименование, Истина);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Т = Справочники.Товары.СоздатьЭлемент();
	Т.Наименование = Наименование;
	Т.Родитель = Группа;
	Т.ЦветТовара = Справочники.ЦветаТоваров.НайтиПоКоду(ИмяЦвета);
	Т.СтранаТовара = Справочники.СтраныТоваров.НайтиПоКоду(ИмяСтраны);
	Т.Записать();
	Возврат Т.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьПриход(Склад, ДатаДок, Данные)
	Док = Документы.ПриходТоваров.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Склад = Склад;
	Для Каждого Поз Из Данные.Позиции Цикл
		Стр = Док.СписокТоваров.Добавить();
		Стр.Товар = Поз.Товар;
		Стр.ЦветТовара = Поз.Товар.ЦветТовара;
		Стр.СтранаТовара = Поз.Товар.СтранаТовара;
		Стр.Количество = Поз.Количество;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьРасход(Склад, ДатаДок, Товар, Количество)
	Док = Документы.РасходТоваров.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Склад = Склад;
	Стр = Док.СписокТоваров.Добавить();
	Стр.Товар = Товар;
	Стр.ЦветТовара = Товар.ЦветТовара;
	Стр.СтранаТовара = Товар.СтранаТовара;
	Стр.Количество = Количество;
	Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры
