// Наполнение конфигурации «Экскурсии» демонстрационными данными.
// Модуль служебный: нужен только для подготовки базы к скриншотам.

Процедура Заполнить() Экспорт

	Москва   = СоздатьРегион("Москва");
	Питер    = СоздатьРегион("Санкт-Петербург");
	Золотое  = СоздатьРегион("Золотое кольцо");

	Кремль   = СоздатьЭкскурсию("Московский Кремль",        Москва,  2500);
	Метро    = СоздатьЭкскурсию("Метро: подземные дворцы",  Москва,  1800);
	Эрмитаж  = СоздатьЭкскурсию("Эрмитаж",                  Питер,   3200);
	Разводка = СоздатьЭкскурсию("Развод мостов",            Питер,   2100);
	Суздаль  = СоздатьЭкскурсию("Суздаль за один день",     Золотое, 4500);

	Иванов   = СоздатьКлиента("Иванов И.И.");
	Петрова  = СоздатьКлиента("Петрова А.С.");
	Сидоров  = СоздатьКлиента("Сидоров Д.С.");
	Кузнецов = СоздатьКлиента("Кузнецов П.П.");

	Б1 = СоздатьБронь(Дата(2026, 8, 3, 10, 0, 0),  Иванов,   Кремль);
	Б2 = СоздатьБронь(Дата(2026, 8, 5, 11, 0, 0),  Петрова,  Эрмитаж);
	Б3 = СоздатьБронь(Дата(2026, 8, 7, 9, 30, 0),  Сидоров,  Суздаль);
	Б4 = СоздатьБронь(Дата(2026, 8, 9, 12, 0, 0),  Кузнецов, Кремль);
	Б5 = СоздатьБронь(Дата(2026, 8, 12, 14, 0, 0), Иванов,   Метро);
	Б6 = СоздатьБронь(Дата(2026, 8, 15, 16, 0, 0), Петрова,  Разводка);
	Б7 = СоздатьБронь(Дата(2026, 8, 18, 10, 0, 0), Сидоров,  Эрмитаж);
	Б8 = СоздатьБронь(Дата(2026, 8, 20, 10, 0, 0), Кузнецов, Суздаль);

	СоздатьПосещение(Дата(2026, 8, 4, 10, 0, 0),  Б1, Наличными());
	СоздатьПосещение(Дата(2026, 8, 6, 11, 0, 0),  Б2, Картой());
	СоздатьПосещение(Дата(2026, 8, 8, 9, 30, 0),  Б3, Картой());
	СоздатьПосещение(Дата(2026, 8, 10, 12, 0, 0), Б4, Наличными());
	СоздатьПосещение(Дата(2026, 8, 13, 14, 0, 0), Б5, Наличными());
	СоздатьПосещение(Дата(2026, 8, 16, 16, 0, 0), Б6, Картой());
	СоздатьПосещение(Дата(2026, 8, 19, 10, 0, 0), Б7, Картой());
	СоздатьПосещение(Дата(2026, 8, 21, 10, 0, 0), Б8, Наличными());

КонецПроцедуры

Функция Наличными()
	Возврат Перечисления.СпособОплаты.Наличными;
КонецФункции

Функция Картой()
	Возврат Перечисления.СпособОплаты.БанковскойКартой;
КонецФункции

Функция СоздатьРегион(Имя)
	Об = Справочники.Регионы.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьКлиента(Имя)
	Об = Справочники.Клиенты.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьЭкскурсию(Имя, Регион, Стоимость)
	Об = Справочники.Экскурсии.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.Регион = Регион;
	Об.Стоимость = Стоимость;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьБронь(Дата, Клиент, Экскурсия)
	Док = Документы.Бронь.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Клиент = Клиент;
	Док.Экскурсия = Экскурсия;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СоздатьПосещение(Дата, Бронь, Способ)
	Док = Документы.ПосещениеЭкскурсии.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Бронь = Бронь;
	Док.Клиент = Бронь.Клиент;
	Док.Экскурсия = Бронь.Экскурсия;
	Док.Сумма = Бронь.Экскурсия.Стоимость;
	Док.СпособОплаты = Способ;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СформироватьОтчет(ИмяОтчета) Экспорт

	ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
	Схема = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек[0].Настройки);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки());

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);

	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(Процессор);

	Возврат ТабДок;

КонецФункции
