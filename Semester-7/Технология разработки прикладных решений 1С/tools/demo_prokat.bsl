// Наполнение конфигурации «Прокат велосипедов» демонстрационными данными.

Процедура Заполнить() Экспорт

	Горный  = СоздатьМодель("Горный Stels Navigator", 250);
	Город   = СоздатьМодель("Городской Forward", 180);
	Детский = СоздатьМодель("Детский Stern 20", 120);
	Электро = СоздатьМодель("Электровелосипед Eltreco", 500);

	Г1 = СоздатьВелосипед("Г-001", Горный);
	Г2 = СоздатьВелосипед("Г-002", Горный);
	Г3 = СоздатьВелосипед("Г-003", Горный);
	Ц1 = СоздатьВелосипед("Ц-001", Город);
	Ц2 = СоздатьВелосипед("Ц-002", Город);
	Д1 = СоздатьВелосипед("Д-001", Детский);
	Э1 = СоздатьВелосипед("Э-001", Электро);

	Иванов   = СоздатьКлиента("Иванов И.И.", "+7 916 100-10-10", Истина,  "Гостиница «Заря»", "312");
	Петрова  = СоздатьКлиента("Петрова А.С.", "+7 916 200-20-20", Ложь,   "", "");
	Сидоров  = СоздатьКлиента("Сидоров Д.С.", "+7 916 300-30-30", Истина, "Гостиница «Заря»", "118");
	Кузнецов = СоздатьКлиента("Кузнецов П.П.", "+7 916 400-40-40", Ложь,  "", "");

	Резерв = СоздатьРезерв(Дата(2026, 9, 4, 9, 0, 0), Петрова, Город, 1,
		Дата(2026, 9, 5, 10, 0, 0), Дата(2026, 9, 5, 20, 0, 0));

	// Завершённые прокаты — попадают в выручку
	В1 = СоздатьВыдачу(Дата(2026, 9, 1, 10, 0, 0), Иванов, Деньги(), 5000, Неопределено,
		СоставВыдачи(Г1, Дата(2026, 9, 1, 10, 0, 0), Г2, Дата(2026, 9, 1, 10, 0, 0)));
	СоздатьВозврат(Дата(2026, 9, 1, 14, 0, 0), В1, Дата(2026, 9, 1, 14, 0, 0), Ложь);

	В2 = СоздатьВыдачу(Дата(2026, 9, 2, 11, 0, 0), Сидоров, Паспорт(), 0, Неопределено,
		СоставВыдачи(Э1, Дата(2026, 9, 2, 11, 0, 0)));
	СоздатьВозврат(Дата(2026, 9, 2, 13, 30, 0), В2, Дата(2026, 9, 2, 13, 30, 0), Ложь);

	В3 = СоздатьВыдачу(Дата(2026, 9, 3, 12, 0, 0), Кузнецов, ВУ(), 0, Неопределено,
		СоставВыдачи(Ц1, Дата(2026, 9, 3, 12, 0, 0), Д1, Дата(2026, 9, 3, 12, 0, 0)));
	СоздатьВозврат(Дата(2026, 9, 3, 15, 15, 0), В3, Дата(2026, 9, 3, 15, 15, 0), Истина);

	// Открытый прокат — велосипед сейчас у клиента
	СоздатьВыдачу(Дата(2026, 9, 5, 10, 0, 0), Петрова, Деньги(), 5000, Резерв,
		СоставВыдачи(Ц2, Дата(2026, 9, 5, 10, 0, 0)));

КонецПроцедуры

Функция СоставВыдачи(Знач В1, Знач Т1, Знач В2 = Неопределено, Знач Т2 = Неопределено)
	М = Новый Массив;
	М.Добавить(Новый Структура("Велосипед,ВремяВыдачи", В1, Т1));
	Если В2 <> Неопределено Тогда
		М.Добавить(Новый Структура("Велосипед,ВремяВыдачи", В2, Т2));
	КонецЕсли;
	Возврат М;
КонецФункции

Функция Деньги()
	Возврат Перечисления.ВидЗалога.Деньги;
КонецФункции

Функция Паспорт()
	Возврат Перечисления.ВидЗалога.Паспорт;
КонецФункции

Функция ВУ()
	Возврат Перечисления.ВидЗалога.ВодительскоеУдостоверение;
КонецФункции

Функция СоздатьМодель(Имя, Цена)
	Об = Справочники.МоделиВелосипедов.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.ЦенаЗаЧас = Цена;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьВелосипед(Имя, Модель)
	Об = Справочники.Велосипеды.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.Модель = Модель;
	Об.Исправен = Истина;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьКлиента(Имя, Телефон, Постоялец, Гостиница, Комната)
	Об = Справочники.Клиенты.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.Телефон = Телефон;
	Об.ПостоялецГостиницы = Постоялец;
	Об.Гостиница = Гостиница;
	Об.НомерКомнаты = Комната;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьРезерв(Дата, Клиент, Модель, Количество, Начало, Окончание)
	Док = Документы.Резервирование.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Клиент = Клиент;
	Док.Модель = Модель;
	Док.Количество = Количество;
	Док.ДатаНачала = Начало;
	Док.ДатаОкончания = Окончание;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СоздатьВыдачу(Дата, Клиент, ВидЗалога, СуммаЗалога, Резерв, Строки)
	Док = Документы.ВыдачаВелосипедов.СоздатьДокумент();
	Док.Дата = Дата;
	Док.Клиент = Клиент;
	Док.ВидЗалога = ВидЗалога;
	Док.СуммаЗалога = СуммаЗалога;
	Если Резерв <> Неопределено Тогда
		Док.Резерв = Резерв;
	КонецЕсли;
	Для Каждого С Из Строки Цикл
		Стр = Док.Состав.Добавить();
		Стр.Велосипед = С.Велосипед;
		Стр.ВремяВыдачи = С.ВремяВыдачи;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СоздатьВозврат(Дата, Выдача, ВремяВозврата, ЕстьПоломка)
	Док = Документы.ВозвратВелосипедов.СоздатьДокумент();
	Док.Заполнить(Выдача);
	Док.Дата = Дата;
	Первая = Истина;
	Для Каждого Стр Из Док.Состав Цикл
		Стр.ВремяВозврата = ВремяВозврата;
		Если ЕстьПоломка И Первая Тогда
			Стр.Состояние = Перечисления.СостояниеВелосипеда.Испорчен;
		Иначе
			Стр.Состояние = Перечисления.СостояниеВелосипеда.Целый;
		КонецЕсли;
		Первая = Ложь;
	КонецЦикла;
	Док.РассчитатьСтоимость();
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СформироватьОтчет(ИмяОтчета) Экспорт

	ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
	Схема = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек[0].Настройки);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки());

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);

	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(Процессор);

	Возврат ТабДок;

КонецФункции
