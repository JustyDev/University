// Наполнение конфигурации «Контроль годности» демонстрационными данными.

Процедура Заполнить() Экспорт

	Молоко  = СоздатьТовар("Молоко 3,2% (1 л)");
	Творог  = СоздатьТовар("Творог 5% (200 г)");
	Хлеб    = СоздатьТовар("Хлеб ржаной");
	Йогурт  = СоздатьТовар("Йогурт питьевой");

	Строки1 = Новый Массив;
	Строки1.Добавить(Новый Структура("Товар,Количество,СрокГодности", Молоко, 40, Дата(2026, 9, 12)));
	Строки1.Добавить(Новый Структура("Товар,Количество,СрокГодности", Молоко, 25, Дата(2026, 9, 18)));
	Строки1.Добавить(Новый Структура("Товар,Количество,СрокГодности", Творог, 15.500, Дата(2026, 9, 10)));
	СоздатьПоступление(Дата(2026, 9, 1, 9, 0, 0), Строки1);

	Строки2 = Новый Массив;
	Строки2.Добавить(Новый Структура("Товар,Количество,СрокГодности", Хлеб, 60, Дата(2026, 9, 9)));
	Строки2.Добавить(Новый Структура("Товар,Количество,СрокГодности", Йогурт, 30, Дата(2026, 9, 25)));
	Строки2.Добавить(Новый Структура("Товар,Количество,СрокГодности", Творог, 12.250, Дата(2026, 9, 20)));
	СоздатьПоступление(Дата(2026, 9, 2, 10, 0, 0), Строки2);

	Продажи = Новый Массив;
	Продажи.Добавить(Новый Структура("Товар,Количество", Молоко, 18));
	Продажи.Добавить(Новый Структура("Товар,Количество", Творог, 5.750));
	Продажи.Добавить(Новый Структура("Товар,Количество", Хлеб, 22));
	СоздатьПродажу(Дата(2026, 9, 3, 18, 0, 0), Продажи);

КонецПроцедуры

Функция СоздатьТовар(Имя)
	Об = Справочники.Товары.СоздатьЭлемент();
	Об.Наименование = Имя;
	Об.Записать();
	Возврат Об.Ссылка;
КонецФункции

Функция СоздатьПоступление(Дата, Строки)
	Док = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Док.Дата = Дата;
	Для Каждого С Из Строки Цикл
		Стр = Док.Состав.Добавить();
		Стр.Товар = С.Товар;
		Стр.Количество = С.Количество;
		Стр.СрокГодности = С.СрокГодности;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СоздатьПродажу(Дата, Строки)
	Док = Документы.ПродажаТоваров.СоздатьДокумент();
	Док.Дата = Дата;
	Для Каждого С Из Строки Цикл
		Стр = Док.Состав.Добавить();
		Стр.Товар = С.Товар;
		Стр.Количество = С.Количество;
	КонецЦикла;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
КонецФункции

Функция СформироватьОтчет(ИмяОтчета) Экспорт

	ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
	Схема = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек[0].Настройки);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки());

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);

	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(Процессор);

	Возврат ТабДок;

КонецФункции
