// Наполнение конфигурации «Простой склад» демонстрационными данными.
// Модуль временный: используется только для подготовки базы к скриншотам,
// в сдаваемую конфигурацию не входит.

Процедура Заполнить() Экспорт

	СоздатьЭлементыПоСписку(Справочники.ЦветаТоваров, "Зеленый,Красный,Стальной,Белый,Черный");
	СоздатьЭлементыПоСписку(Справочники.СтраныТоваров, "Россия,Китай,Германия");

	СкладОсновной = СоздатьСклад("Склад основной", "Москва, ул. Строительная, д. 1", НачалоДня(ТекущаяДатаСеанса()));
	СкладДопол    = СоздатьСклад("Склад дополнительный", "Тверь, ул. Садовая, д. 2", Дата(1, 1, 1));

	ГруппаТехника = СоздатьГруппуТоваров("Бытовая техника");
	ГруппаСад     = СоздатьГруппуТоваров("Для сада и огорода");
	ГруппаЭлектро = СоздатьГруппуТоваров("Электроника");

	Чайник  = СоздатьТовар("Чайник (3 л)",         ГруппаТехника, "Стальной", "Россия");
	Грабли  = СоздатьТовар("Грабли садовые",       ГруппаСад,     "Зеленый",  "Россия");
	Краска  = СоздатьТовар("Краска половая (5 л)", ГруппаСад,     "Красный",  "Китай");
	Наушники= СоздатьТовар("Наушники",             ГруппаЭлектро, "Черный",   "Китай");
	Часы    = СоздатьТовар("Умные часы",           ГруппаЭлектро, "Белый",    "Германия");

	Позиции1 = Новый Массив;
	Позиции1.Добавить(Новый Структура("Товар,Количество", Чайник, 50));
	Позиции1.Добавить(Новый Структура("Товар,Количество", Грабли, 20));
	Позиции1.Добавить(Новый Структура("Товар,Количество", Наушники, 15));
	СоздатьПриход(СкладОсновной, Дата(2026, 9, 1, 12, 0, 0), Позиции1);

	Позиции2 = Новый Массив;
	Позиции2.Добавить(Новый Структура("Товар,Количество", Краска, 30));
	Позиции2.Добавить(Новый Структура("Товар,Количество", Часы, 10));
	СоздатьПриход(СкладДопол, Дата(2026, 9, 2, 13, 0, 0), Позиции2);

	Позиции3 = Новый Массив;
	Позиции3.Добавить(Новый Структура("Товар,Количество", Чайник, 12));
	СоздатьРасход(СкладОсновной, Дата(2026, 9, 3, 14, 0, 0), Позиции3);

КонецПроцедуры

Процедура СоздатьЭлементыПоСписку(Менеджер, Список)

	Для Каждого Имя Из СтрРазделить(Список, ",") Цикл
		Если Менеджер.НайтиПоКоду(Имя).Пустая() Тогда
			Элемент = Менеджер.СоздатьЭлемент();
			Элемент.Код = Имя;
			Элемент.Наименование = Имя;
			Элемент.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СоздатьСклад(Наименование, Адрес, ДатаИнвентаризации)

	Ссылка = Справочники.Склады.НайтиПоНаименованию(Наименование, Истина);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Элемент = Справочники.Склады.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.АдресСклада = Адрес;
	Если Метаданные.Справочники.Склады.Реквизиты.Найти("Инвентаризация") <> Неопределено Тогда
		Элемент.Инвентаризация = ДатаИнвентаризации;
	КонецЕсли;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

Функция СоздатьГруппуТоваров(Наименование)

	Ссылка = Справочники.Товары.НайтиПоНаименованию(Наименование, Истина);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Группа = Справочники.Товары.СоздатьГруппу();
	Группа.Наименование = Наименование;
	Группа.Записать();
	Возврат Группа.Ссылка;

КонецФункции

Функция СоздатьТовар(Наименование, Группа, ИмяЦвета, ИмяСтраны)

	Ссылка = Справочники.Товары.НайтиПоНаименованию(Наименование, Истина);
	Если НЕ Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Товар = Справочники.Товары.СоздатьЭлемент();
	Товар.Наименование = Наименование;
	Товар.Родитель = Группа;
	Товар.ЦветТовара = Справочники.ЦветаТоваров.НайтиПоКоду(ИмяЦвета);
	Товар.СтранаТовара = Справочники.СтраныТоваров.НайтиПоКоду(ИмяСтраны);
	Товар.Записать();
	Возврат Товар.Ссылка;

КонецФункции

Процедура СоздатьПриход(Склад, ДатаДокумента, Позиции)

	Документ = Документы.ПриходТоваров.СоздатьДокумент();
	Документ.Дата = ДатаДокумента;
	Документ.Склад = Склад;
	Для Каждого Позиция Из Позиции Цикл
		Строка = Документ.СписокТоваров.Добавить();
		Строка.Товар = Позиция.Товар;
		Строка.ЦветТовара = Позиция.Товар.ЦветТовара;
		Строка.СтранаТовара = Позиция.Товар.СтранаТовара;
		Строка.Количество = Позиция.Количество;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

Процедура СоздатьРасход(Склад, ДатаДокумента, Позиции)

	Документ = Документы.РасходТоваров.СоздатьДокумент();
	Документ.Дата = ДатаДокумента;
	Документ.Склад = Склад;
	Для Каждого Позиция Из Позиции Цикл
		Строка = Документ.СписокТоваров.Добавить();
		Строка.Товар = Позиция.Товар;
		Строка.ЦветТовара = Позиция.Товар.ЦветТовара;
		Строка.СтранаТовара = Позиция.Товар.СтранаТовара;
		Строка.Количество = Позиция.Количество;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// Выгрузка отчётов в PDF — чтобы приложить к отчёту по лабораторной
// реальный результат работы, а не пустую форму отчёта.
Функция СформироватьОтчет(ИмяОтчета) Экспорт

	ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
	Схема = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.ВариантыНастроек[0].Настройки);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Компоновщик.ПолучитьНастройки());

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);

	ТабДок = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
	ПроцессорВывода.Вывести(Процессор);

	Возврат ТабДок;

КонецФункции
