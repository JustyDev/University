Процедура ОбработкаПроведения(Отказ, Режим)

	// Приход партии: количество ложится в регистр в разрезе товара и срока годности.
	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого ТекСтрокаСостав Из Состав Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаСостав.Товар;
		Движение.СрокГодности = НачалоДня(ТекСтрокаСостав.СрокГодности);
		Движение.Количество = ТекСтрокаСостав.Количество;
	КонецЦикла;

КонецПроцедуры
