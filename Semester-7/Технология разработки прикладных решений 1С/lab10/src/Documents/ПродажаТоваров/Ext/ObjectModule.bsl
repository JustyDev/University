Процедура ОбработкаПроведения(Отказ, Режим)

	// Списание партиями по возрастанию срока годности (FEFO).
	Движения.ОстаткиТоваров.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПродажаСостав.Товар КАК Товар,
		|	СУММА(ПродажаСостав.Количество) КАК Количество
		|ПОМЕСТИТЬ ДОК
		|ИЗ
		|	Документ.ПродажаТоваров.Состав КАК ПродажаСостав
		|ГДЕ
		|	ПродажаСостав.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ПродажаСостав.Товар
		|ИНДЕКСИРОВАТЬ ПО
		|	Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.Товар КАК Товар,
		|	Остатки.СрокГодности КАК СрокГодности,
		|	Остатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ОСТ
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(, Товар В (ВЫБРАТЬ ДОК.Товар ИЗ ДОК КАК ДОК)) КАК Остатки
		|ИНДЕКСИРОВАТЬ ПО
		|	Товар
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДОК.Товар КАК Товар,
		|	ДОК.Количество КАК Требуется,
		|	ОСТ.СрокГодности КАК СрокГодности,
		|	ЕСТЬNULL(ОСТ.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	ДОК КАК ДОК
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОСТ КАК ОСТ
		|		ПО ДОК.Товар = ОСТ.Товар
		|УПОРЯДОЧИТЬ ПО
		|	Товар,
		|	СрокГодности
		|ИТОГИ
		|	МАКСИМУМ(Требуется)
		|ПО
		|	Товар";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	ВыборкаТовары = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Товар");

	Пока ВыборкаТовары.Следующий() Цикл

		ОсталосьСписать = ВыборкаТовары.Требуется;
		ВыборкаПартии = ВыборкаТовары.Выбрать();

		Пока ВыборкаПартии.Следующий() Цикл

			Если ОсталосьСписать <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если ВыборкаПартии.Остаток <= 0 Тогда
				Продолжить;
			КонецЕсли;

			СписатьИзПартии = Мин(ОсталосьСписать, ВыборкаПартии.Остаток);

			Движение = Движения.ОстаткиТоваров.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Товар = ВыборкаТовары.Товар;
			Движение.СрокГодности = ВыборкаПартии.СрокГодности;
			Движение.Количество = СписатьИзПартии;

			ОсталосьСписать = ОсталосьСписать - СписатьИзПартии;

		КонецЦикла;

		Если ОсталосьСписать > 0 Тогда
			Отказ = Истина;
			Сообщить("Не хватает товара " + ВыборкаТовары.Товар
				+ ": не хватает " + Формат(ОсталосьСписать, "ЧГ=0"));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
