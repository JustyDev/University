&НаКлиенте
Процедура Сформировать(Команда)

	СформироватьНаСервере();

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Товар КАК Товар,
		|	Остатки.СрокГодности КАК СрокГодности,
		|	Остатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
		|УПОРЯДОЧИТЬ ПО
		|	Товар,
		|	СрокГодности";

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Область(1, 1).Текст = "Товар";
	ТабДок.Область(1, 2).Текст = "Срок годности";
	ТабДок.Область(1, 3).Текст = "Количество";

	НомерСтроки = 1;
	Итого = 0;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		ТабДок.Область(НомерСтроки, 1).Текст = Строка(Выборка.Товар);
		// Задание 10, пункт 1: выводим только дату, без 00:00:00
		ТабДок.Область(НомерСтроки, 2).Текст = Формат(Выборка.СрокГодности, "ДЛФ=D");
		ТабДок.Область(НомерСтроки, 3).Текст = Формат(Выборка.Количество, "ЧДЦ=3; ЧН=0");
		Итого = Итого + Выборка.Количество;
	КонецЦикла;

	ТабДок.Область(НомерСтроки + 1, 1).Текст = "Итого";
	ТабДок.Область(НомерСтроки + 1, 3).Текст = Формат(Итого, "ЧДЦ=3; ЧН=0");

	РезультатОтчета = ТабДок;

КонецПроцедуры
