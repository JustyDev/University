Процедура ОбработкаПроведения(Отказ, Режим)

	// Выдача: велосипед уходит в прокат, резерв под модель снимается.
	Движения.ВелосипедыВПрокате.Записывать = Истина;
	Движения.Резервы.Записывать = Истина;

	Для Каждого ТекСтрокаСостав Из Состав Цикл

		Движение = Движения.ВелосипедыВПрокате.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Велосипед = ТекСтрокаСостав.Велосипед;
		Движение.Клиент = Клиент;
		Движение.Количество = 1;

		Если ЗначениеЗаполнено(Резерв) Тогда
			Снятие = Движения.Резервы.Добавить();
			Снятие.ВидДвижения = ВидДвиженияНакопления.Расход;
			Снятие.Период = Дата;
			Снятие.Модель = ТекСтрокаСостав.Велосипед.Модель;
			Снятие.Количество = 1;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
