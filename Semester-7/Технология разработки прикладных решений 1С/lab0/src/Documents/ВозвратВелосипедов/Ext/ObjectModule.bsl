Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	// Ввод на основании выдачи: переносим клиента и список велосипедов.
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ВыдачаВелосипедов") Тогда
		Выдача = ДанныеЗаполнения;
		Клиент = ДанныеЗаполнения.Клиент;
		Состав.Очистить();
		Для Каждого СтрокаВыдачи Из ДанныеЗаполнения.Состав Цикл
			НоваяСтрока = Состав.Добавить();
			НоваяСтрока.Велосипед = СтрокаВыдачи.Велосипед;
			НоваяСтрока.ВремяВыдачи = СтрокаВыдачи.ВремяВыдачи;
			НоваяСтрока.ВремяВозврата = ТекущаяДата();
			НоваяСтрока.Состояние = Перечисления.СостояниеВелосипеда.Целый;
		КонецЦикла;
		РассчитатьСтоимость();
	КонецЕсли;

КонецПроцедуры

Процедура РассчитатьСтоимость() Экспорт

	// Время проката округляем вверх до часа: неполный час считается полным.
	Для Каждого Строка Из Состав Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ВремяВыдачи) ИЛИ НЕ ЗначениеЗаполнено(Строка.ВремяВозврата) Тогда
			Продолжить;
		КонецЕсли;
		Секунды = Строка.ВремяВозврата - Строка.ВремяВыдачи;
		Если Секунды < 0 Тогда
			Секунды = 0;
		КонецЕсли;
		Часы = Цел(Секунды / 3600);
		Если Секунды % 3600 > 0 Тогда
			Часы = Часы + 1;
		КонецЕсли;
		Строка.Часы = Часы;
		Строка.Сумма = Часы * Строка.Велосипед.Модель.ЦенаЗаЧас;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	РассчитатьСтоимость();

	Движения.ВелосипедыВПрокате.Записывать = Истина;
	Движения.Выручка.Записывать = Истина;

	Для Каждого ТекСтрокаСостав Из Состав Цикл

		Движение = Движения.ВелосипедыВПрокате.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Велосипед = ТекСтрокаСостав.Велосипед;
		Движение.Клиент = Клиент;
		Движение.Количество = 1;

		Оборот = Движения.Выручка.Добавить();
		Оборот.Период = Дата;
		Оборот.Модель = ТекСтрокаСостав.Велосипед.Модель;
		Оборот.Клиент = Клиент;
		Оборот.Часы = ТекСтрокаСостав.Часы;
		Оборот.Сумма = ТекСтрокаСостав.Сумма;

		// Испорченный велосипед выводим из оборота — признак снимается вручную
		// после ремонта, в карточке велосипеда.
		Если ТекСтрокаСостав.Состояние = Перечисления.СостояниеВелосипеда.Испорчен Тогда
			ОбъектВелосипеда = ТекСтрокаСостав.Велосипед.ПолучитьОбъект();
			ОбъектВелосипеда.Исправен = Ложь;
			ОбъектВелосипеда.Записать();
			Сообщить("Велосипед " + ТекСтрокаСостав.Велосипед + " помечен как испорченный.");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
