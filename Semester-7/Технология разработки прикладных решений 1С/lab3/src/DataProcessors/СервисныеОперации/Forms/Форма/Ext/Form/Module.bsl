#Область СлужебныеПроцедуры

&НаКлиенте
Функция КатегорияУказана()

	Если НЕ ЗначениеЗаполнено(КатегорияТоваров) Тогда
		Сообщить("Укажите категорию товаров.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ЗаменаЦветаИСтраны

// Задание 3. Цвет заменяется только у товаров выбранной категории.
// В поле выбора категории разрешён выбор только групп, элемент указать нельзя.
&НаСервереБезКонтекста
Процедура ЗаменаЦветаНаСервере(Категория)

	ВыборкаТоваров = Справочники.Товары.Выбрать(Категория);
	Заменено = 0;

	Пока ВыборкаТоваров.Следующий() Цикл
		Если ВыборкаТоваров.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		Если СокрЛП(ВыборкаТоваров.ЦветТовара) = "Зеленый" Тогда
			ТекущийТовар = ВыборкаТоваров.Ссылка.ПолучитьОбъект();
			ТекущийТовар.ЦветТовара = Справочники.ЦветаТоваров.НайтиПоКоду("Красный");
			ТекущийТовар.Записать();
			Заменено = Заменено + 1;
			Сообщить("Для товара " + ТекущийТовар.Наименование + " заменен зеленый цвет на красный.");
		КонецЕсли;
	КонецЦикла;

	Если Заменено = 0 Тогда
		Сообщить("В категории " + Категория + " товаров зелёного цвета не найдено.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаменаЦвета(Команда)

	Если КатегорияУказана() Тогда
		ЗаменаЦветаНаСервере(КатегорияТоваров);
	КонецЕсли;

КонецПроцедуры

// Задание 3. Страна заменяется только у товаров выбранной категории.
&НаСервереБезКонтекста
Процедура ЗаменаСтраныНаСервере(Категория)

	ВыборкаТоваров = Справочники.Товары.Выбрать(Категория);
	Заменено = 0;

	Пока ВыборкаТоваров.Следующий() Цикл
		Если ВыборкаТоваров.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		Если СокрЛП(ВыборкаТоваров.СтранаТовара) = "Китай" Тогда
			ТекущийТовар = ВыборкаТоваров.Ссылка.ПолучитьОбъект();
			ТекущийТовар.СтранаТовара = Справочники.СтраныТоваров.НайтиПоКоду("Россия");
			ТекущийТовар.Записать();
			Заменено = Заменено + 1;
			Сообщить("Для товара " + ТекущийТовар.Наименование + " заменена страна Китай на Россию.");
		КонецЕсли;
	КонецЦикла;

	Если Заменено = 0 Тогда
		Сообщить("В категории " + Категория + " товаров из Китая не найдено.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаменаСтраны(Команда)

	Если КатегорияУказана() Тогда
		ЗаменаСтраныНаСервере(КатегорияТоваров);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
