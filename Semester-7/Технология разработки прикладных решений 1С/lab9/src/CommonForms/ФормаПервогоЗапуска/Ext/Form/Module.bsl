&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Приветствие = "Добро пожаловать в конфигурацию «Простой склад»! Это окно "
		+ "показывается один раз — при первом запуске программы.";

	// Задание 8, пункт 2: показываем склады, у которых инвентаризация сегодня.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Склады.Наименование КАК Наименование,
		|	Склады.АдресСклада КАК АдресСклада
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(Склады.Инвентаризация, ДЕНЬ) = &Сегодня";
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(Выборка.Наименование + " (" + Выборка.АдресСклада + ")");
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		СкладыСИнвентаризацией = "На сегодня инвентаризация не запланирована ни на одном складе.";
	Иначе
		СкладыСИнвентаризацией = "Сегодня инвентаризация на складах: "
			+ СтрСоединить(Строки, ", ") + ".";
	КонецЕсли;

	// Признак первого запуска выставляем сами — кнопка «Больше не показывать» не нужна.
	УстановитьПризнакПервогоЗапуска();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьПризнакПервогоЗапуска()

	Константы.ПервыйЗапускОсуществлен.Установить(Истина);

КонецПроцедуры
