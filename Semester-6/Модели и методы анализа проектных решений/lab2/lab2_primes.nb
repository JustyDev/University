Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"primeList", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"candidates", " ", "=", " ", 
    RowBox[{"{", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"candidates", ",", " ", "n"}], "]"}], ";", "\n", "  ", 
      RowBox[{"divisors", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerQ", "[", 
            RowBox[{"N", "[", 
             RowBox[{"n", "/", "k"}], "]"}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"n", ",", " ", "k"}], "]"}], " ", "==", " ", "0"}]}], ",",
           " ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"divisors", ",", " ", "k"}], "]"}]}], "]"}], ",", "\n", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "2", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "\n", "  ", "]"}], ";",
       "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"divisors", ",", " ", 
            RowBox[{"{", "}"}]}], "]"}], " ", "===", " ", 
          RowBox[{"{", "}"}]}], " ", "&&", " ", 
         RowBox[{"n", " ", ">", " ", "1"}]}], ",", " ", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"primeList", ",", " ", "n"}], "]"}]}], "]"}], ";", "\n", 
      "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "primeList", "]"}], " ", ">=", " ", "10"}], ",",
         " ", 
        RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "2", ",", " ", "100"}], "}"}]}], "\n", "]"}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"xValues", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"Length", "[", "primeList", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"points", " ", "=", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"xValues", ",", " ", "primeList"}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"fitModel", " ", "=", " ", 
   RowBox[{"Fit", "[", 
    RowBox[{"points", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "x", ",", " ", 
       RowBox[{"x", "^", "2"}]}], "}"}], ",", " ", "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"approxValues", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"fitModel", " ", "/.", " ", 
      RowBox[{"x", " ", "->", " ", "i"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "xValues"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errors", " ", "=", " ", 
    RowBox[{"primeList", " ", "-", " ", "approxValues"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"maxError", " ", "=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", "errors", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mse", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Mean", "[", 
     RowBox[{"errors", "^", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mae", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{"Mean", "[", 
      RowBox[{"Abs", "[", "errors", "]"}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"combinedPlot", " ", "=", " ", 
    RowBox[{"Show", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"ListPlot", "[", "\n", "    ", 
       RowBox[{"points", ",", "\n", "    ", 
        RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "    ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Blue", ",", " ", 
           RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}]}], ",", "\n", 
        "    ", 
        RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", 
        "    ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"{", "\"\<Prime numbers\>\"", "}"}]}], ",", "\n", "    ", 
        RowBox[{
        "PlotLabel", " ", "->", 
         " ", "\"\<First 10 Prime Numbers and Quadratic Approximation\>\""}], 
        ",", "\n", "    ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Index\>\"", ",", " ", "\"\<Value\>\""}], "}"}]}], ",", 
        "\n", "    ", 
        RowBox[{"AxesOrigin", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", "\n", "    ", 
        RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "\n", "  ", "]"}], ",",
       "\n", "  ", 
      RowBox[{"Plot", "[", "\n", "    ", 
       RowBox[{"fitModel", ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "primeList", "]"}]}], "}"}], ",", "\n", 
        "    ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{"Red", ",", " ", 
           RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}]}], ",", "\n", 
        "    ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"{", "\"\<Quadratic fit\>\"", "}"}]}], ",", "\n", "    ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Index\>\"", ",", " ", "\"\<Value\>\""}], "}"}]}], ",", 
        "\n", "    ", 
        RowBox[{"AxesOrigin", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", "\n", "    ", 
        RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "\n", "  ", "]"}], ",",
       "\n", "  ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
      RowBox[{"ImagePadding", " ", "->", " ", "20"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"figure1", " ", "=", " ", 
    RowBox[{"Show", "[", "\n", "  ", 
     RowBox[{"combinedPlot", ",", "\n", "  ", 
      RowBox[{"ListPlot", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xValues", ",", " ", "errors"}], "}"}], "]"}], ",", "\n", 
        "    ", 
        RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\n", "    ", 
        RowBox[{"PlotStyle", " ", "->", " ", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"Darker", "[", "Green", "]"}], ",", " ", 
           RowBox[{"Thickness", "[", "0.006", "]"}]}], "]"}]}], ",", "\n", 
        "    ", 
        RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", 
        "    ", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"{", "\"\<Approximation error\>\"", "}"}]}], ",", "\n", 
        "    ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Index\>\"", ",", " ", "\"\<Error\>\""}], "}"}]}], ",", 
        "\n", "    ", 
        RowBox[{"AxesOrigin", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0"}], "}"}]}], ",", "\n", "    ", 
        RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "\n", "  ", "]"}], ",",
       "\n", "  ", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
      RowBox[{
      "PlotLabel", " ", "->", 
       " ", "\"\<Figure 1. Primes, Quadratic Approximation, and Error\>\""}], 
      ",", "\n", "  ", 
      RowBox[{"ImagePadding", " ", "->", " ", "20"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", "primeList", "\n", "points", "\n", "fitModel", "\n", \
"approxValues", "\n", "maxError", "\n", "mse", "\n", "mae", "\n", \
