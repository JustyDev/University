Cell[CellGroupData[{

Cell["\<\
(* ===== Section 3: Quadratic LSM approximation ===== *)

fitModel = Fit[points, {1, x, x^2}, x];
Print[\"\:041a\:0432\:0430\:0434\:0440\:0430\:0442\:0438\:0447\:043d\:0430\
\:044f \:0430\:043f\:043f\:0440\:043e\:043a\:0441\:0438\:043c\:0430\:0446\
\:0438\:044f: y = \", fitModel // InputForm]

approxPlot = Plot[
  fitModel,
  {x, 1, 10},
  PlotStyle   -> Directive[Orange, Thickness[0.005]],
  PlotLegends -> Placed[{\"\:0410\:043f\:043f\:0440\:043e\:043a\:0441\:0438\
\:043c\:0430\:0446\:0438\:044f \:0440\:044f\:0434\:0430 \:043f\:0440\:043e\
\:0441\:0442\:044b\:0445 \:0447\:0438\:0441\:0435\:043b\"}, {Right, Top}]
];

combinedPlot = Show[
  primePlot,
  approxPlot,
  PlotRange    -> All,
  ImagePadding -> 30
];

combinedPlot\
\>", "Input",
 CellChangeTimes->{{3.9872200000008*^9, 3.9872200000009*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"a1b2c3d4-0004-0001-0001-000000000001"],

