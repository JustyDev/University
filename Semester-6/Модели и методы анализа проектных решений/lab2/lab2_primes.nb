Cell[CellGroupData[{

Cell["\<\
(* ===== Section 5: Figure 1 \[AHat]\.80\.94 original data + approximation + \
error ===== *)

errorPoints = Transpose[{xValues, Abs[errors]}];
errorPlot = ListPlot[
  errorPoints,
  Joined      -> True,
  PlotStyle   -> Directive[Darker[Red], Thickness[0.005]],
  PlotMarkers -> {Automatic, Medium},
  PlotLegends -> Placed[{\"\:041e\:0448\:0438\:0431\:043a\:0430 \:0430\:043f\
\:043f\:0440\:043e\:043a\:0441\:0438\:043c\:0430\:0446\:0438\:0438\"}, \
{Right, Top}]
];

figure1 = Show[
  combinedPlot,
  errorPlot,
  PlotRange    -> All,
  PlotLabel    -> \"\:041f\:0440\:043e\:0441\:0442\:044b\:0435 \:0447\:0438\
\:0441\:043b\:0430\",
  AxesLabel    -> {\"x\", \"y\"},
  AxesOrigin   -> {0, 0},
  ImagePadding -> 30
];

figure1\
\>", "Input",
 CellChangeTimes->{{3.9872200000014*^9, 3.9872200000015*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"a1b2c3d4-0006-0001-0001-000000000001"],

