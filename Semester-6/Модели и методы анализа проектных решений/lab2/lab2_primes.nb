Cell[CellGroupData[{

Cell["\<\
(* ===== Section 4: Error computation: MSE, MAE, max error ===== *)
(* Using Table as required *)

approxValues = Table[fitModel /. x -> i, {i, xValues}];
errors       = N[primeList - approxValues];

maxError = Max[Abs[errors]];
n   = Length[primeList];
mse = N[(1/n) Total[errors^2]];
mae = N[(1/n) Total[Abs[errors]]];

Print[\"\:0421\:0438\:0433\:043c\:0430 \:0430\:043f\:043f\:0440\:043e\:043a\
\:0441\:0438\:043c\:0430\:0446\:0438\:0438: \", N[approxValues]];
Print[\"\:041e\:0441\:0442\:0430\:0442\:043a\:0438 (Yi - \
Y\:0445\:0430\:0442_i): \", errors];
Print[\"Max |error| = \", maxError // N];
Print[\"MSE = \", mse];
Print[\"MAE = \", mae]\
\>", "Input",
 CellChangeTimes->{{3.9872200000011*^9, 3.9872200000012*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"a1b2c3d4-0005-0001-0001-000000000001"],

